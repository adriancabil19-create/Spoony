PORT=3000
NODE_ENV=development

# =========================
# SUPABASE (AUTH + DATABASE + STORAGE)
# =========================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Direct PostgreSQL connection (Supabase → Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[SUPABASE_HOST]:5432/postgres

# =========================
# BACKEND
# =========================
API_BASE_URL=https://your-backend.onrender.com

# JWT — generate: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Admin account seeded on first run
ADMIN_EMAIL=admin@spoony.com
ADMIN_PASSWORD=Admin@1234

# =========================
# MAPS (OPENSTREETMAP)
# =========================
MAP_PROVIDER=openstreetmap
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OPENROUTESERVICE_API_KEY=your_optional_ors_key

# =========================
# CORS
# =========================
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:8080,http://localhost:3000
